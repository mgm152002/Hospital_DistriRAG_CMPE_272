# Copy to deploy/.env.cloud on the VM. Never commit the real file.
DEPLOYMENT_PROFILE=hybrid
DOMAIN=distrirag.example.org
LLM_PROVIDER=openrouter-free          # or azure-openai (set its base_url in config/providers.yaml)
OPENROUTER_API_KEY=
EMBED_PROVIDER=minilm
BLOB_PROVIDER=s3                       # or azure
S3_BUCKET=distrirag-demo
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# AZURE_CONNECTION_STRING=
ALLOWED_HOSTS=["postgres","redis","localhost","openrouter.ai","s3.amazonaws.com","amazonaws.com"]
SYNTHETIC_DATA_ONLY=true
AUTH_MODE=header                       # switch to oidc before inviting anyone
