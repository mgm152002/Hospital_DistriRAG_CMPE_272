# Pick one: lite (weak hardware, no models) | airgapped (local Ollama) | hybrid (external LLM) | cloud
DEPLOYMENT_PROFILE=lite
# The hospital this deployment serves, shown in the UI.
HOSPITAL_NAME=Riverside General Hospital
HOSPITAL_CODE=RGH-001
HOSPITAL_CAMPUS=Main campus
# LLM_PROVIDER=fake            # none | fake | local-ollama | openrouter-free | local-proxy | azure-openai
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# External chat providers: openrouter-free (OpenRouter) and local-proxy (CLIProxyAPI).
# LLM_PROVIDER picks the default; an administrator can switch between the two at runtime
# in Settings (the choice is saved in CHAT_SETTINGS_PATH and overrides LLM_PROVIDER).
# LLM_PROVIDER=openrouter-free
# EXTERNAL_MAX_CLASSIFICATION=internal
# CLIProxyAPI endpoint and client key:
# LOCAL_PROXY_BASE_URL=http://host.docker.internal:8317/v1
# LOCAL_PROXY_MODEL=gpt-6-luna
# LOCAL_PROXY_API_KEY=         # client key from the proxy configuration; never commit this key
# Allow both hosts so either provider can be selected at runtime:
# ALLOWED_HOSTS=["postgres","redis","localhost","openrouter.ai","host.docker.internal"]
# LLM_ANSWER_TIMEOUT_SECONDS=15
# CHAT_SETTINGS_PATH=data/settings/chat.json  # Docker uses a private persistent volume
# EMBED_PROVIDER=hashing       # hashing (no download) | minilm (ONNX, ~90 MB)
# BLOB_PROVIDER=local          # local | s3 | azure
SYNTHETIC_DATA_ONLY=true
PHI_MODE=block
AUTH_MODE=local
REGISTRATION_ENABLED=true
# Synthetic demonstration accounts only; disable for a real deployment.
DEMO_ACCOUNTS_ENABLED=true
# DEMO_ACCOUNT_PASSWORD=DemoAccess!2026
# AUTH_SESSION_HOURS=12
# AUTH_COOKIE_SECURE=true      # enable behind HTTPS
# PORT=8080                    # host port; app still listens on 8000 inside Docker
